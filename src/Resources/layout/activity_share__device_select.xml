<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
	<androidx.recyclerview.widget.RecyclerView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/deviceSelector"
        android:scrollbars="horizontal"
        android:layout_centerInParent="true" />
	<ImageView
        android:id="@+id/emptyDeviceListView"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:padding="32dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_fluent_share_24_regular"
        android:tint="@color/m3_ref_palette_cyan90"
        android:background="@drawable/material_shape_cookie_9"
        android:backgroundTint="@color/m3_ref_palette_cyan30" />
</RelativeLayout>