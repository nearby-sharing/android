<?xml version="1.0" encoding="utf-8" ?>
<androidx.core.widget.NestedScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:clipToPadding="false">

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="10dp">

		<!-- Welcome animation -->
		<ImageView
			android:id="@+id/welcomeImageView"
			android:layout_width="300dp"
			android:layout_height="300dp"
			android:layout_gravity="center"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:tint="@null"
			android:src="@drawable/animation_welcome" />

		<!-- Quick send actions -->
		<com.google.android.material.button.MaterialButtonGroup
			style="@style/AppTheme.Material3Expressive.MaterialButtonGroup.Connected"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:layout_marginBottom="20dp"
			android:gravity="center_horizontal"
			app:overflowMode="menu">

			<!-- Send File -->
			<Button
				style="?attr/materialButtonStyle"
				android:id="@+id/sendFileButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:icon="@drawable/ic_fluent_document_24_regular"
				android:text="@string/send_file" />

			<!-- Send Clipboard -->
			<Button
				style="?attr/materialButtonTonalStyle"
				android:id="@+id/sendClipBoardButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:icon="@drawable/ic_fluent_clipboard_24_regular"
				android:text="@string/send_clipboard" />

			<!-- Send Text -->
			<Button
				style="?attr/materialButtonTonalStyle"
				android:id="@+id/sendTextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:icon="@drawable/ic_fluent_text_description_24_regular"
				android:text="@string/send_text" />

		</com.google.android.material.button.MaterialButtonGroup>

		<TextView
			style="@style/AppTheme.Material3Expressive.ListItemHeader"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/quick_actions" />

		<!-- Enable Bluetooth -->
		<com.google.android.material.listitem.ListItemCardView
			style="@style/AppTheme.Material3Expressive.ListItemCard"
			app:shapeAppearance="?attr/listItemShapeAppearanceFirst"
			android:id="@+id/enableBluetoothCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clickable="true"
			android:focusable="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:src="@drawable/ic_fluent_bluetooth_24_regular"/>
				<TextView
					style="@style/Widget.Material3.TextView.ListItem.LabelText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/request_enable_bluetooth" />
			</LinearLayout>
		</com.google.android.material.listitem.ListItemCardView>

		<!-- Setup Windows -->
		<com.google.android.material.listitem.ListItemCardView
			style="@style/AppTheme.Material3Expressive.ListItemCard"
			android:id="@+id/setupWindowsCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clickable="true"
			android:focusable="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:src="@drawable/ic_fluent_window_new_24_regular"/>
				<TextView
					style="@style/Widget.Material3.TextView.ListItem.LabelText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/open_setup_summary" />
			</LinearLayout>
		</com.google.android.material.listitem.ListItemCardView>

		<!-- Open FAQ -->
		<com.google.android.material.listitem.ListItemCardView
			style="@style/AppTheme.Material3Expressive.ListItemCard"
			android:id="@+id/openFaqCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clickable="true"
			android:focusable="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:src="@drawable/ic_fluent_question_circle_24_regular"/>
				<TextView
					style="@style/Widget.Material3.TextView.ListItem.LabelText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/open_faq_summary" />
			</LinearLayout>
		</com.google.android.material.listitem.ListItemCardView>

		<!-- Open Crowdin -->
		<com.google.android.material.listitem.ListItemCardView
			style="@style/AppTheme.Material3Expressive.ListItemCard"
			app:shapeAppearance="?attr/listItemShapeAppearanceLast"
			android:id="@+id/openCrowdinCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clickable="true"
			android:focusable="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					android:src="@drawable/ic_fluent_translate_24_regular"/>
				<TextView
					style="@style/Widget.Material3.TextView.ListItem.LabelText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/open_crowdin_summary" />
			</LinearLayout>
		</com.google.android.material.listitem.ListItemCardView>

	</LinearLayout>

</androidx.core.widget.NestedScrollView>