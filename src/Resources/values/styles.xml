<resources>
	<style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
		<item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Material3Expressive.DynamicColors.DayNight</item>

		<!-- Title bar -->
		<item name="elevationOverlayEnabled">false</item>

		<!-- Status bar -->
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">?attr/isLightTheme</item>

		<!-- Navigation bar -->
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightNavigationBar">?attr/isLightTheme</item>

		<item name="switchStyle">?attr/materialSwitchStyle</item>
		<item name="alertDialogTheme">?attr/materialAlertDialogTheme</item>
		<item name="dialogCornerRadius">28dp</item>
		<item name="android:tint">?attr/colorOnSurface</item>
	</style>

	<style name="AppTheme.DialogActivity" parent="@style/Theme.Material3.DayNight.SideSheetDialog">
		<item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Material3Expressive.DynamicColors.DayNight</item>

		<item name="sideSheetModalStyle">@style/Widget.Material3.SideSheet.Modal.Detached</item>

		<item name="android:windowFrame">@null</item>
		<item name="android:windowIsFloating">false</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="windowNoTitle">true</item>
		<item name="android:background">@android:color/transparent</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:enforceStatusBarContrast">false</item>
		<item name="android:enforceNavigationBarContrast">false</item>
	</style>

	<style name="AppTheme.Material3Expressive.MaterialButtonGroup.Connected" parent="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected">
		<item name="materialThemeOverlay">@style/ThemeOverlay.Material3Expressive.MaterialButtonGroup.Overflow</item>
	</style>

	<style name="AppTheme.Material3Expressive.ListItemCard" parent="@style/Widget.Material3.ListItemCardView.Segmented">
		<item name="cardBackgroundColor">?attr/colorSurfaceContainerHighest</item>
		<item name="shapeAppearance">?attr/listItemShapeAppearanceMiddle</item>
		<item name="android:layout_marginBottom">2dp</item>
		<item name="android:minHeight">56dp</item>
		<item name="android:gravity">center_vertical</item>
	</style>

	<style name="AppTheme.Material3Expressive.ListItemHeader" parent="">
		<item name="android:minHeight">?attr/minTouchTargetSize</item>
		<item name="android:padding">18dp</item>
		<item name="android:gravity">center_vertical|start</item>
		<item name="android:maxLines">1</item>
		<item name="android:textAlignment">viewStart</item>
		<item name="android:paddingHorizontal">8dp</item>
		<item name="android:textAppearance">@style/TextAppearance.AppCompat.Caption</item>
		<item name="android:textColor">?android:textColorPrimary</item>
	</style>

</resources>
